{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "scripts/cli-conformance.ts",
    "scripts/provider-conformance.ts",
    "testing/integration/cli/terminal-browser/child.ts",
    "testing/e2e/scenarios/**/*.test.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.ts",
    "evals/**/*.ts",
    "testing/**/*.{ts,tsx}",
    "!**/*.test.{ts,tsx}",
    "!evals/fixtures/**",
    "!testing/fixtures/**",
    "!testing/compat/fixtures/v3-pre-change-writer/**",
    "!testing/e2e/*.config.ts"
  ],
  "ignoreExportsUsedInFile": true,
  "includeEntryExports": true
}
