{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["src/engine/ipc/server-entry.ts", "testing/e2e/scenarios/**/*.test.ts"],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.ts",
    "evals/**/*.ts",
    "testing/**/*.ts",
    "!**/*.test.ts",
    "!evals/fixtures/**",
    "!testing/fixtures/**"
  ],
  "ignoreDependencies": ["tree-sitter-typescript", "@anthropic-ai/claude-agent-sdk"],
  "ignoreExportsUsedInFile": true,
  "includeEntryExports": true
}
