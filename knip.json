{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/engine/ipc/server-entry.ts",
    "scripts/cli-conformance.ts",
    "scripts/provider-conformance.ts",
    "testing/e2e/scenarios/**/*.test.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.ts",
    "evals/**/*.ts",
    "testing/**/*.{ts,tsx}",
    "!**/*.test.{ts,tsx}",
    "!evals/fixtures/**",
    "!testing/fixtures/**",
    "!testing/e2e/*.config.ts"
  ],
  "ignoreDependencies": ["node-pty"],
  "ignoreExportsUsedInFile": true,
  "includeEntryExports": true
}
