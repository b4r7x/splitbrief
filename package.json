{
  "name": "diptych",
  "version": "0.1.0",
  "description": "Cost-optimized AI coding orchestrator - uses expensive AI for planning, cheap/local AI for implementation",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "diptych": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc",
    "typecheck": "npm run typecheck:src && npm run typecheck:test",
    "typecheck:src": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test-ci": "npm run typecheck && npm run lint && npm test"
  },
  "keywords": [
    "ai",
    "coding",
    "orchestrator",
    "opus",
    "ollama",
    "local-model",
    "cost-optimization"
  ],
  "imports": {
    "#testing/*": "./testing/*"
  },
  "license": "MIT",
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "*"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    }
  },
  "dependencies": {
    "ansis": "^3.0.0",
    "cfonts": "^3.3.1",
    "commander": "^14.0.0",
    "fullscreen-ink": "^0.1.0",
    "fzf": "^0.5.2",
    "ink": "^6.8.0",
    "openai": "^6.0.0",
    "react": "^19.0.0",
    "shiki": "^4.0.0",
    "simple-git": "^3.0.0",
    "wrap-ansi": "^10.0.0",
    "yaml": "^2.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.0",
    "vitest": "^4.1.2"
  }
}
