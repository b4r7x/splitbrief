{
  "name": "tiny-spec",
  "version": "0.1.0",
  "description": "Cost-optimized AI coding orchestrator - uses expensive AI for planning, cheap/local AI for implementation",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "tiny-spec": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc",
    "test": "tsx --test tests/**/*.test.ts",
    "test:integration": "INTEGRATION=true tsx --test --test-timeout=60000 tests/integration/*.integration.test.ts",
    "test:all": "INTEGRATION=true tsx --test --test-timeout=60000 tests/**/*.test.ts"
  },
  "keywords": [
    "ai",
    "coding",
    "orchestrator",
    "opus",
    "ollama",
    "local-model",
    "cost-optimization"
  ],
  "license": "MIT",
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "ansis": "^3.0.0",
    "cfonts": "^3.3.1",
    "commander": "^14.0.0",
    "fullscreen-ink": "^0.1.0",
    "ink": "^6.8.0",
    "ink-multiline-input": "^0.1.0",
    "openai": "^6.0.0",
    "react": "^19.0.0",
    "shiki": "^4.0.0",
    "simple-git": "^3.0.0",
    "yaml": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.0"
  }
}
