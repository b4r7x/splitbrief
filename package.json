{
  "name": "diptych",
  "version": "0.1.0",
  "description": "Cost-optimized AI coding orchestrator - uses expensive AI for planning, cheap/local AI for implementation",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist/",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "bin": {
    "diptych": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "rm -rf dist && tsc",
    "prepack": "npm run build",
    "typecheck": "npm run typecheck:src && npm run typecheck:test",
    "typecheck:src": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config testing/e2e/vitest.e2e.config.ts",
    "test:e2e:record": "DIPTYCH_E2E_RECORD=1 vitest run --config testing/e2e/vitest.e2e.config.ts",
    "eval": "tsx evals/cli.ts",
    "eval:record": "tsx evals/cli.ts --record",
    "eval:replay": "tsx evals/cli.ts --replay",
    "check:invariants": "tsx scripts/check-invariants.ts",
    "knip": "knip",
    "test-ci": "npm run format:check && npm run typecheck && npm run lint && npm run test:coverage && npm run check:invariants",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "coding",
    "orchestrator",
    "opus",
    "ollama",
    "local-model",
    "cost-optimization"
  ],
  "imports": {
    "#testing/*": "./testing/*"
  },
  "license": "MIT",
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    }
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-base": "^2.7.0",
    "ansis": "^3.0.0",
    "better-sqlite3": "^12.9.0",
    "commander": "^14.0.0",
    "fullscreen-ink": "^0.1.0",
    "fzf": "^0.5.2",
    "ink": "^6.8.0",
    "openai": "^6.0.0",
    "react": "^19.0.0",
    "simple-git": "^3.0.0",
    "tree-sitter-typescript": "^0.23.2",
    "web-tree-sitter": "^0.26.8",
    "wrap-ansi": "^10.0.0",
    "yaml": "^2.0.0",
    "zod": "^4.3.6"
  },
  "optionalDependencies": {
    "tree-sitter-wasms": "^0.1.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "dependency-cruiser": "^17.4.3",
    "ink-testing-library": "^4.0.0",
    "knip": "^5.88.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.0",
    "vitest": "^4.1.2"
  }
}
