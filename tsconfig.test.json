{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "lib": ["ES2024", "DOM"],
    "types": ["node", "react"],
    "paths": {
      "#testing/*": ["./testing/*"]
    }
  },
  "include": [
    "src/**/*",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "testing/**/*",
    "testing/integration/**/*",
    "evals/*.ts",
    "evals/cassette/**/*.ts",
    "evals/scenarios/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
